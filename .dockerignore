# Git and version control
.git
.gitignore

# Python caches and byte-code
__pycache__/
*.pyc
*.pyo
*.pyd

# Local virtual environments
.venv/
venv/
env/
ENV/

# Local configuration and secret files
.env
*.env

# SQLite local databases (so you don't overwrite production data)
*.sqlite3
*.db

# Django media files and collected static assets
