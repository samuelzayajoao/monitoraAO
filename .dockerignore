.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE and OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker build notes/logs
Dockerfile
docker-compose.yml
*.log